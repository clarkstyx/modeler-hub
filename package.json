{
  "name": "modeler-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "pull": "node scripts/pull.mjs",
    "sync-shared": "node scripts/sync-shared.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2025-01-01",
    "deploy": "npm run pull && npm run build && wrangler pages deploy dist --project-name modeler-hub",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "wrangler": "^3.90.0"
  }
}
